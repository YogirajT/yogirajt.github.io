<!doctype html>
<html lang="en" data-i18n-page>
  {% include "head.njk" %}

  <body>
    <!-- ================================================================
     COOKIE CONSENT (first in the DOM so keyboard users reach it first)
     ================================================================ -->
    {% include "partials/chrome.njk" %}

    <main id="main" tabindex="-1">
      <!-- ============ HERO ============ -->
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="wrap">
          <div class="hero-text">
            <p class="eyebrow hero-eyebrow" data-i18n="{{ hero.eyebrow.key }}">{{ hero.eyebrow.en }}</p>
            <h1 id="hero-title">
              <span aria-hidden="true">{{ site.alternateName | e }}</span
              ><span class="sr-only">{{ site.name | e }}</span>
            </h1>
            <p class="hero-role">
              <span id="typewriter" data-i18n="{{ hero.role.key }}"
                >{{ hero.role.en }}</span
              >
            </p>
            <p class="hero-pitch" data-i18n="{{ hero.pitch.key }}">{{ hero.pitch.en }}</p>
            <div class="hero-cta">
              <a
                class="btn btn-primary"
                href="assets/cv.pdf"
                target="_blank"
                rel="noopener"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M12 3v12" />
                  <path d="M7 10l5 5 5-5" />
                  <path d="M4 21h16" />
                </svg>
                <span data-i18n="{{ hero.cta.download.key }}">{{ hero.cta.download.en }}</span
                ><span class="sr-only" data-i18n="{{ ui.a11y.pdfnewtab.key }}">{{ ui.a11y.pdfnewtab.en }}</span
                >
              </a>
              <a
                class="btn btn-ghost"
                href="mailto:{{ site.email }}"
                data-i18n="{{ hero.cta.hello.key }}"
                >{{ hero.cta.hello.en }}</a
              >
            </div>
            <ul
              class="hero-social icon-row"
              role="list"
              aria-label="{{ ui.aria.socialGroup.enText | e }}"
              data-i18n-attr="aria-label:{{ ui.aria.socialGroup.key }}"
            >
              <li>
                <a
                  class="icon-link"
                  href="{{ site.social.github }}"
                  target="_blank"
                  rel="noopener"
                  title="GitHub"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55v-2c-3.16.69-3.82-1.36-3.82-1.36-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.53-.29-5.18-1.26-5.18-5.62 0-1.24.44-2.25 1.16-3.05-.12-.29-.5-1.45.11-3.02 0 0 .95-.3 3.12 1.16a10.8 10.8 0 015.68 0c2.16-1.46 3.11-1.16 3.11-1.16.62 1.57.23 2.73.11 3.02.73.8 1.16 1.81 1.16 3.05 0 4.37-2.66 5.33-5.19 5.61.41.35.77 1.04.77 2.11v3.13c0 .3.2.66.79.55 4.5-1.5 7.76-5.76 7.76-10.78C23.02 5.24 18.27.5 12 .5z"
                    />
                  </svg>
                  <span class="sr-only"
                    >GitHub<span data-i18n="{{ ui.a11y.newtab.key }}">{{ ui.a11y.newtab.en }}</span
                    ></span
                  >
                </a>
              </li>
              <li>
                <a
                  class="icon-link"
                  href="{{ site.social.linkedin }}"
                  target="_blank"
                  rel="noopener"
                  title="LinkedIn"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.68H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 110-4.13 2.07 2.07 0 010 4.13zM7.11 20.45H3.56V9h3.55v11.45z"
                    />
                  </svg>
                  <span class="sr-only"
                    >LinkedIn<span data-i18n="{{ ui.a11y.newtab.key }}">{{ ui.a11y.newtab.en }}</span
                    ></span
                  >
                </a>
              </li>
              <li>
                <a
                  class="icon-link"
                  href="mailto:{{ site.email }}"
                  title="{{ ui.aria.socialEmail.enText | e }}"
                  data-i18n-attr="title:{{ ui.aria.socialEmail.key }}"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="M2 7l10 6 10-6" />
                  </svg>
                  <span class="sr-only" data-i18n="{{ ui.social.email.key }}">{{ ui.social.email.en }}</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="hero-visual">
            <!-- <div class="avatar-wrap">
            <div class="avatar-slot" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
              </svg>
            </div>
          </div> -->
            <div
              class="arch-cycler"
              data-arch-cycler
              role="region"
              aria-label="{{ ui.aria.archRegion.enText | e }}"
              aria-roledescription="{{ ui.aria.archRoledesc.enText | e }}"
              data-i18n-attr="aria-label:{{ ui.aria.archRegion.key }};aria-roledescription:{{ ui.aria.archRoledesc.key }}"
            >
              <div class="arch-stage">
                {% for a in hero.architectures %}
{% include "diagrams/" + a.id + ".html" %}
{% endfor %}
              </div>
              <div class="arch-controls">
                <button
                  type="button"
                  class="arch-pause"
                  data-arch-pause
                  aria-label="Pause diagram rotation"
                  hidden
                >
                  <svg
                    class="icon-pause"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="6" y="5" width="4" height="14" rx="1" />
                    <rect x="14" y="5" width="4" height="14" rx="1" />
                  </svg>
                  <svg
                    class="icon-play"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"
                    />
                  </svg>
                </button>
                <div
                  class="arch-dots"
                  role="toolbar"
                  aria-orientation="horizontal"
                  aria-label="{{ ui.aria.archGroup.enText | e }}"
                  data-i18n-attr="aria-label:{{ ui.aria.archGroup.key }}"
                  data-arch-dots
                >
                  {% for a in hero.architectures %}
                  <button type="button" class="arch-dot{% if a._first %} is-active{% endif %}" data-arch-target="{{ a.id }}"{% if a._first %} aria-current="true"{% endif %}>
                    <span class="sr-only" data-i18n="{{ a.name.key }}">{{ a.name.en }}</span>
                  </button>
                  {% endfor %}
                  </div>
              </div>
              <p class="sr-only" role="status" data-arch-status></p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ ABOUT ============ -->
      <section class="about reveal" id="about" aria-labelledby="about-title">
        <div class="wrap">
          <div class="about-copy">
            <p class="eyebrow" data-i18n="{{ about.eyebrow.key }}">{{ about.eyebrow.en }}</p>
            <h2
              id="about-title"
              style="
                margin-top: 0.6rem;
                font-size: clamp(1.7rem, 3.4vw, 2.35rem);
              "
              data-i18n="{{ about.title.key }}"
            >{{ about.title.en }}</h2>
            <div style="margin-top: 1.4rem">
              {% for p in about.paragraphs %}
<p data-i18n="{{ p.key }}">{{ p.en }}</p>
{% endfor %}
            </div>
          </div>
          <aside
            class="facts"
            aria-label="{{ ui.aria.facts.enText | e }}"
            data-i18n-attr="aria-label:{{ ui.aria.facts.key }}"
          >
            <dl>
{% for f in about.facts %}
              <div>
                <dt data-i18n="{{ f.label.key }}">{{ f.label.en }}</dt>
                <dd data-i18n="{{ f.value.key }}">{{ f.value.en }}</dd>
              </div>
{% endfor %}
            </dl>
          </aside>
        </div>
      </section>

      <!-- ============ EXPERIENCE ============ -->
      <section
        class="experience reveal"
        id="experience"
        aria-labelledby="experience-title"
      >
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow" data-i18n="{{ experience.eyebrow.key }}">{{ experience.eyebrow.en }}</p>
            <h2 id="experience-title" data-i18n="{{ experience.title.key }}">{{ experience.title.en }}</h2>
            <p data-i18n="{{ experience.subtitle.key }}">{{ experience.subtitle.en }}</p>
          </div>

          <div class="timeline">
            {% for job in experience.jobs %}
            <article class="job{% if job.current %} job-current{% endif %}">
              <div class="job-card">
                <div class="job-head">
                  <div>
                    <h3 class="job-title">{{ job.title | e }}</h3>
                    <p class="job-company">
                      {{ job.company | e }}
                      <span class="job-location" data-i18n="{{ experience.places[job.place].key }}">{{ experience.places[job.place].en }}</span>
                    </p>
                  </div>
                  <span class="job-dates" data-i18n="{{ job.dates.key }}">{{ job.dates.en }}</span>
                </div>
                <ul class="job-bullets">
                  {% for b in job.bullets %}
                  <li data-i18n="{{ b.key }}">{{ b.en }}</li>
                  {% endfor %}
                </ul>
                <ul class="tag-row" role="list" aria-label="{{ ui.aria.tech.enText | e }}" data-i18n-attr="aria-label:{{ ui.aria.tech.key }}">
                  {% for tag in job.tags %}
                  <li class="tag">{{ tag | e }}</li>
                  {% endfor %}
                </ul>
              </div>
            </article>
            {% endfor %}
          </div>

          <div class="earlier">
            <h3 data-i18n="{{ experience.earlierTitle.key }}">{{ experience.earlierTitle.en }}</h3>
            <div class="earlier-grid">
              {% for e in experience.earlier %}
              <div class="earlier-item">
                <h4 data-i18n="{{ e.heading.key }}">{{ e.heading.en }}</h4>
                <span class="job-dates" data-i18n="{{ e.dates.key }}">{{ e.dates.en }}</span>
                <p data-i18n="{{ e.summary.key }}">{{ e.summary.en }}</p>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>

      <!-- ============ SKILLS ============ -->
      <section class="skills reveal" id="skills" aria-labelledby="skills-title">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow" data-i18n="{{ skills.eyebrow.key }}">{{ skills.eyebrow.en }}</p>
            <h2 id="skills-title" data-i18n="{{ skills.title.key }}">{{ skills.title.en }}</h2>
          </div>
          <div class="skill-groups">
            {% for g in skills.groups %}
            <div class="skill-group">
              <h3 id="skill-{{ g.id }}" data-i18n="{{ g.title.key }}">{{ g.title.en }}</h3>
              <ul class="skill-tags" role="list" aria-labelledby="skill-{{ g.id }}">
                {% for tag in g.tags %}
                <li class="tag">{{ tag | e }}</li>
                {% endfor %}
              </ul>
            </div>
            {% endfor %}
          </div>
        </div>
      </section>

      <!-- ============ EDUCATION / LANGUAGES ============ -->
      <section
        class="edu reveal"
        id="education"
        aria-labelledby="education-title"
      >
        <h2 class="sr-only" id="education-title" data-i18n="{{ education.srTitle.key }}">{{ education.srTitle.en }}</h2>
        <div class="wrap">
          <div class="edu-block">
            <h3 data-i18n="{{ education.title.key }}">{{ education.title.en }}</h3>
            <ul class="edu-list">
              {% for d in education.degrees %}
              <li>{% if d.title.key %}<strong data-i18n="{{ d.title.key }}">{{ d.title.en }}</strong>{% else %}<strong>{{ d.title.en }}</strong>{% endif %}<span>{{ d.institution | e }} &middot; {{ d.years }}</span></li>
              {% endfor %}
            </ul>
          </div>
          <div class="edu-block">
            <h3 data-i18n="{{ education.languagesTitle.key }}">{{ education.languagesTitle.en }}</h3>
            <ul class="lang-list" role="list">
              {% for l in education.languages %}
              {% set lv = education.levels[l.level] %}
              <li class="lang-row">{% if l.name.key %}<span data-i18n="{{ l.name.key }}">{{ l.name.en }}</span>{% else %}<span>{{ l.name.en }}</span>{% endif %}{% if lv.key %}<span data-i18n="{{ lv.key }}">{{ lv.en }}</span>{% else %}<span>{{ lv.en }}</span>{% endif %}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </section>

      <!-- ============ CONTACT ============ -->
      <section
        class="contact reveal"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="wrap">
          <p
            class="eyebrow"
            style="justify-content: center"
            data-i18n="{{ contact.eyebrow.key }}"
          >{{ contact.eyebrow.en }}</p>
          <h2
            id="contact-title"
            style="margin-top: 0.8rem"
            data-i18n="{{ contact.title.key }}"
          >{{ contact.title.en }}</h2>
          <a
            class="contact-mail"
            href="mailto:{{ site.email }}"
            id="contact-mail-link"
            >{{ site.email }}</a
          >
          <button
            type="button"
            class="copy-btn"
            id="copy-email"
            style="display: none"
            aria-label="{{ ui.aria.copyEmail.enText | e }}"
            title="{{ ui.aria.copyEmail.enText | e }}"
            data-i18n-attr="aria-label:{{ ui.aria.copyEmail.key }};title:{{ ui.aria.copyEmail.key }}"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="vertical-align: -2px"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" />
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
            </svg>
          </button>
          <p class="contact-sub" data-i18n="{{ contact.sub.key }}">{{ contact.sub.en }}</p>
          <div class="contact-cta">
            <a
              class="btn btn-primary"
              href="assets/cv.pdf"
              target="_blank"
              rel="noopener"
              ><span data-i18n="{{ contact.ctaDownload.key }}">{{ contact.ctaDownload.en }}</span
              ><span class="sr-only" data-i18n="{{ ui.a11y.pdfnewtab.key }}">{{ ui.a11y.pdfnewtab.en }}</span
              ></a
            >
            <a
              class="btn btn-ghost"
              href="{{ site.social.linkedin }}"
              target="_blank"
              rel="noopener"
              ><span data-i18n="{{ contact.ctaLinkedin.key }}">{{ contact.ctaLinkedin.en }}</span
              ><span class="sr-only" data-i18n="{{ ui.a11y.newtab.key }}">{{ ui.a11y.newtab.en }}</span
              ></a
            >
          </div>
          <ul
            class="contact-social icon-row"
            role="list"
            aria-label="{{ ui.aria.socialGroup.enText | e }}"
            data-i18n-attr="aria-label:{{ ui.aria.socialGroup.key }}"
          >
            <li>
              <a
                class="icon-link"
                href="{{ site.social.github }}"
                target="_blank"
                rel="noopener"
                title="GitHub"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55v-2c-3.16.69-3.82-1.36-3.82-1.36-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.53-.29-5.18-1.26-5.18-5.62 0-1.24.44-2.25 1.16-3.05-.12-.29-.5-1.45.11-3.02 0 0 .95-.3 3.12 1.16a10.8 10.8 0 015.68 0c2.16-1.46 3.11-1.16 3.11-1.16.62 1.57.23 2.73.11 3.02.73.8 1.16 1.81 1.16 3.05 0 4.37-2.66 5.33-5.19 5.61.41.35.77 1.04.77 2.11v3.13c0 .3.2.66.79.55 4.5-1.5 7.76-5.76 7.76-10.78C23.02 5.24 18.27.5 12 .5z"
                  />
                </svg>
                <span class="sr-only"
                  >GitHub<span data-i18n="{{ ui.a11y.newtab.key }}">{{ ui.a11y.newtab.en }}</span
                  ></span
                >
              </a>
            </li>
            <li>
              <a
                class="icon-link"
                href="{{ site.social.linkedin }}"
                target="_blank"
                rel="noopener"
                title="LinkedIn"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.68H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 110-4.13 2.07 2.07 0 010 4.13zM7.11 20.45H3.56V9h3.55v11.45z"
                  />
                </svg>
                <span class="sr-only"
                  >LinkedIn<span data-i18n="{{ ui.a11y.newtab.key }}">{{ ui.a11y.newtab.en }}</span
                  ></span
                >
              </a>
            </li>
          </ul>

          {% include "partials/footer.njk" %}
        </div>
      </section>
    </main>

  </body>
</html>
