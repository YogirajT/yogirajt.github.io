    <div
      class="cookie-banner"
      id="cookie-banner"
      role="dialog"
      aria-modal="false"
      aria-labelledby="cookie-title"
      aria-describedby="cookie-description"
      hidden
    >
      <div class="cookie-banner__content">
        <p
          class="cookie-banner__eyebrow"
          aria-hidden="true"
          data-i18n="{{ ui.cookie.eyebrow.key }}"
        >{{ ui.cookie.eyebrow.en }}</p>
        <h2 id="cookie-title" data-i18n="{{ ui.cookie.title.key }}">{{ ui.cookie.title.en }}</h2>
        <p id="cookie-description" data-i18n="{{ ui.cookie.desc.key }}">{{ ui.cookie.desc.en }}</p>
        <div class="cookie-banner__actions">
          <button
            class="cookie-btn cookie-btn--secondary"
            id="cookie-reject"
            type="button"
            data-i18n="{{ ui.cookie.reject.key }}"
          >{{ ui.cookie.reject.en }}</button>
          <button
            class="cookie-btn cookie-btn--primary"
            id="cookie-accept"
            type="button"
            data-i18n="{{ ui.cookie.accept.key }}"
          >{{ ui.cookie.accept.en }}</button>
        </div>
        <a
          class="cookie-settings-link"
          href="{{ page.cookiePolicyHref }}"
          data-i18n="{{ ui.cookie.policy.key }}"
          >{{ ui.cookie.policy.en }}</a
        >
      </div>
    </div>

    <div class="theme-transition-overlay" aria-hidden="true"></div>
    <div class="ambient-layer" aria-hidden="true">
      <div class="ambient-rain"></div>
      <div class="ambient-leaves"></div>
      <div class="ambient-glow"></div>
      <div class="ambient-lightning"></div>
      <svg
        class="ambient-bolt"
        preserveAspectRatio="none"
        focusable="false"
      ></svg>
    </div>

