<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ seo.title.enText | e }}</title>

    <meta name="description" content="{{ seo.description.enText | e }}" />
    <meta name="author" content="{{ site.name | e }}" />
    <link rel="canonical" href="{{ site.url }}/" />

    <!-- Language versions. English is the default and is fully present in this HTML. German is
       switched on by scripts (?ln=de or the EN/DE toggle), so these tell search engines it exists. -->
    <link rel="alternate" hreflang="en" href="{{ site.url }}/" />
    <link
      rel="alternate"
      hreflang="de"
      href="{{ site.url }}/?ln=de"
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href="{{ site.url }}/"
    />

    <meta
      name="google-site-verification"
      content="{{ site.googleSiteVerification }}"
    />
    <meta http-equiv="Permissions-Policy" content="interest-cohort=()" />
    <meta name="theme-color" content="{{ site.theme.light }}" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Open Graph -->
    <meta property="og:site_name" content="{{ site.name | e }}" />
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="{{ site.firstName | e }}" />
    <meta property="profile:last_name" content="{{ site.lastName | e }}" />
    <meta property="og:locale" content="{{ seo.locale.en }}" />
    <meta property="og:locale:alternate" content="{{ seo.locale.de }}" />
    <meta property="og:title" content="{{ seo.ogTitle.enText | e }}" />
    <meta property="og:description" content="{{ seo.ogDescription.enText | e }}" />
    <meta
      property="og:image"
      content="{{ site.url }}/assets/og-image.png"
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ seo.ogImageAlt.enText | e }}" />
    <meta property="og:url" content="{{ site.url }}/" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ seo.ogTitle.enText | e }}" />
    <meta name="twitter:description" content="{{ seo.ogDescription.enText | e }}" />
    <meta
      name="twitter:image"
      content="{{ site.url }}/assets/og-image.png"
    />
    <meta name="twitter:image:alt" content="{{ seo.ogImageAlt.enText | e }}" />

    {% include "partials/head-assets.njk" %}
    {% include "partials/boot.njk" %}
    <link rel="stylesheet" href="styles.css?v={{ hash.styles }}" />
    <!-- defer: fetched in parallel with everything else above, instead of only
         being discovered once the parser reaches the bottom of the document. -->
    <script src="i18n.js?v={{ hash.i18n }}" defer></script>
    <script src="scripts.js?v={{ hash.scripts }}" defer></script>

    <!-- Structured data -->
    <script type="application/ld+json" id="ld-json">{{ ldJson | safe }}</script>
  </head>